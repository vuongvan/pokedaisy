--- /dev/null
+++ b/app/src/main/kotlin/com/pokedaisy/app/companion/data/RomExtras.kt
@@ -0,0 +1,27 @@
+package com.pokedaisy.app.companion.data
+
+/**
+ * What one game's ROM adds to the shared tables, read from the ROM (a generator script) or checked on it: one [RomExtras] per
+ * game build family, in its own file (RomSoulGold.kt, RomQuetzal.kt...), listed in [ROM_EXTRAS] (RomExtrasRegistry.kt). The shared
+ * code asks [romExtras] for the running game, so a new ROM is its own files plus one line of the registry (docs/ROM_EXTRAS.md).
+ */
+class RomExtras(
+    val kind: GameKind,
+    /** Each move's accuracy, PP, side effect chance, priority and effect name (what [moveEffectWords] knows), index = move id. */
+    val moveStats: List<MoveStats>? = null,
+    /** One digit per move id: 0 physical, 1 special, 2 status, for a game with the split on each move. */
+    val moveKinds: String? = null,
+    /** Field-function sets of builds whose gSpecials starts with HealPlayerParty: CENTER is offered as HEAL only on a match
+     * ([PokemonCenter.healOnly]). */
+    val healOnly: () -> List<FieldItemFns> = { emptyList() },
+    /** The game flies with any Pokémon that can learn Fly: FLY needs no one that knows it (the first non-egg Pokémon flies). */
+    val flyAnyMon: Boolean = false,
+)
+
+/** The extras of [kind], or null. */
+fun romExtras(kind: GameKind?): RomExtras? = if (kind == null) null else ROM_EXTRAS.firstOrNull { it.kind == kind }
+
+/** The category a generated table's digit names: 0 physical, 1 special, 2 status. */
+internal fun kindOfDigit(c: Char?): MoveKind? = when (c) {
+    '0' -> MoveKind.PHYSICAL; '1' -> MoveKind.SPECIAL; '2' -> MoveKind.STATUS; else -> null
+}
