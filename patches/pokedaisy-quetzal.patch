+#!/usr/bin/env python3
+"""MoveStatsQuetzal.kt: Quetzal's accuracy, PP, priority, category and effect names, from the English Alpha 9 v1 ROM.
+
+gBattleMoves (the Pokémon Quetzal English Alpha 9 v1 ROM): 0x18-byte entries from 0x085441D8, by move id. Per entry: +0 u16
+effect, +2 power, +3 type, +4 accuracy (0 = never misses), +5 PP, +6 secondary effect chance, +0x0A s8 priority, +0x0B the
+move's category (0 physical, 1 special, 2 status: Quetzal has the split on each move), +0x0F bit 6 = high critical hit ratio,
++0x12 bit 6 = hits twice.
+
+The effect NAMES (the games' own, "BURN_HIT", "SLEEP"...: what moveEffectWords knows) come from the vanilla table
+(MoveStatsGen.kt): Quetzal keeps Emerald's effect numbers for Emerald's effects, so for the moves both games share (ids 1-354)
+each Quetzal effect is given the name the vanilla moves of that number have most often; one seen only on new moves gets none.
+Effect 0 (a plain hit here, where the vanilla table has separate effects for them) is named from the fields above: high
+critical ratio, hits twice, strikes first (priority), never misses (accuracy 0 with power), else HIT.
+Checked against known moves (Thunder 70 / 10 PP, Quick Attack +1, Protect +4 and status, Swift 0 and special, Bite physical, Gust
+special, Flamethrower burn 10%) and against MoveDataQuetzal.kt's types and powers.
+
+usage: gen_quetzal_move_stats.py PokemonQuetzalEnglishAlpha9v1.gba
+"""
+import collections, hashlib, re, struct, sys, pathlib
+
+BASE, STRIDE, COUNT = 0x085441D8, 0x18, 849
+SHA1 = "c108cec750a35775084c0806cc704d8abd1994e7"
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+DATA = ROOT / "app/src/main/kotlin/com/pokedaisy/app/companion/data"
+
+rom = open(sys.argv[1], "rb").read()
+assert hashlib.sha1(rom).hexdigest() == SHA1, "not Quetzal English Alpha 9 v1"
+u8 = lambda a: rom[a - 0x08000000]
+u16 = lambda a: struct.unpack_from("<H", rom, a - 0x08000000)[0]
+s8 = lambda a: struct.unpack_from("<b", rom, a - 0x08000000)[0]
+vanilla = [m.group(1) for m in re.finditer(r'^\s+MoveStats\("([A-Z0-9_]*)", \d+, \d+, \d+, -?\d+\),',
+                                           (DATA / "MoveStatsGen.kt").read_text(), re.M)]
+
+rows = []
+for i in range(COUNT):
+    e = BASE + i * STRIDE
+    rows.append(dict(effect=u16(e), power=u8(e + 2), type=u8(e + 3), acc=u8(e + 4), pp=u8(e + 5), chance=u8(e + 6), prio=s8(e + 0x0A),
+                     cat=u8(e + 0x0B), crit=bool(u8(e + 0x0F) & 0x40), double=bool(u8(e + 0x12) & 0x40)))
+
+chk = {33: (100, 35, 0, 0), 98: (100, 30, 1, 0), 87: (70, 10, 0, 1), 129: (0, 20, 0, 1), 182: (0, 5, 4, 2), 44: (100, 25, 0, 0), 16: (100, 35, 0, 1)}
+for i, (acc, pp, prio, cat) in chk.items():
+    r = rows[i]
+    assert (r["acc"], r["pp"], r["prio"], r["cat"]) == (acc, pp, prio, cat), (i, r)
+assert max(r["acc"] for r in rows) <= 100 and all(r["cat"] < 3 for r in rows)
+
+votes = collections.defaultdict(collections.Counter)
+for i in range(1, min(355, len(vanilla))):
+    if rows[i]["effect"] != 0:
+        votes[rows[i]["effect"]][vanilla[i]] += 1
+names = {e: c.most_common(1)[0][0] for e, c in votes.items()}
+
+def name_of(r):
+    if r["effect"] == 0:
+        if r["crit"]: return "HIGH_CRITICAL"
+        if r["double"]: return "DOUBLE_HIT"
+        if r["prio"] > 0: return "QUICK_ATTACK"
+        if r["acc"] == 0 and r["power"] > 0: return "ALWAYS_HIT"
+        return "HIT"
+    return names.get(r["effect"], "")
+
+# the field rules agree with the vanilla names on the shared moves they name
+agree = collections.Counter()
+for i in range(1, min(355, len(vanilla))):
+    if rows[i]["effect"] == 0 and vanilla[i] in ("HIGH_CRITICAL", "DOUBLE_HIT", "QUICK_ATTACK", "ALWAYS_HIT", "HIT"):
+        agree[name_of(rows[i]) == vanilla[i]] += 1
+print("field rules vs vanilla names:", dict(agree))
+assert agree[True] >= 0.9 * (agree[True] + agree[False])
+
+for r in rows:
+    r["name"] = name_of(r)
+    r["chance"] = r["chance"] if 0 < r["chance"] < 100 else 0
+
+spot = {53: ("BURN_HIT", 10), 87: ("THUNDER", 30), 44: ("FLINCH_HIT", 30), 33: ("HIT", 0), 98: ("QUICK_ATTACK", 0), 2: ("HIGH_CRITICAL", 0),
+        24: ("DOUBLE_HIT", 0), 129: ("ALWAYS_HIT", 0), 3: ("MULTI_HIT", 0), 147: ("SLEEP", 0)}
+for i, (nm, ch) in spot.items():
+    assert (rows[i]["name"], rows[i]["chance"]) == (nm, ch), (i, rows[i]["name"], rows[i]["chance"])
+
+known = {int(m.group(1)): (int(m.group(2)), int(m.group(3)))
+         for m in re.finditer(r'^\s+(\d+) to MoveInfo\(".*", (\d+), (\d+)\)', (DATA / "MoveDataQuetzal.kt").read_text(), re.M)}
+bad = [i for i, (t, p) in known.items() if i < COUNT and (rows[i]["type"], rows[i]["power"]) != (t, p)]
+print(f"{len(known)} moves in MoveDataQuetzal.kt, {len(bad)} differ in type / power from this ROM", bad[:10])
+print("moves with a name:", sum(1 for r in rows[1:] if r["name"]), "of", COUNT - 1)
+
+out = ["package com.pokedaisy.app.companion.data\n",
+       f"// GENERATED by scripts/gen_quetzal_move_stats.py from the Pokemon Quetzal English Alpha 9 v1 ROM (sha1 {SHA1[:8]}...) - do not hand-edit.",
+       "// gBattleMoves: accuracy (0 = never misses), PP, side effect chance, priority and the effect's name (as the vanilla table",
+       "// spells them) of each move; the category of each move is in moveKindsQuetzal.\n",
+       "internal val moveStatsQuetzal: List<MoveStats> = listOf("]
+for r in rows:
+    out.append(f'    MoveStats("{r["name"]}", {r["acc"]}, {r["pp"]}, {r["chance"]}, {r["prio"]}),')
+out.append(")\n")
+out.append("/** One digit per move id: 0 physical, 1 special, 2 status. */")
+out.append(f'internal const val moveKindsQuetzal: String = "{"".join(str(r["cat"]) for r in rows)}"')
+(DATA / "MoveStatsQuetzal.kt").write_text("\n".join(out) + "\n")
+print("wrote MoveStatsQuetzal.kt,", COUNT, "moves")
