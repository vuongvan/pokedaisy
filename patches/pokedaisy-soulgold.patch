+#!/usr/bin/env python3
+"""MoveStatsSoulGold.kt: SoulGold's accuracy, PP, priority, category and effect names, from the v1.2.1 ROM.
+
+gMovesInfo (pokeemerald-expansion, gcc build): 0x48-byte entries from 0x0877FA48 (the entry for move 0; move 1 "Pound" has the
+only pointer to its name), by move id. Per entry: +0x00 name pointer, +0x04 description pointer, +0x08 u16 effect, +0x0A u16
+type (bits 0-4), category (5-6: 0 physical, 1 special, 2 status) and power (7-15), +0x0C accuracy (low 7 bits; 0 = never misses),
++0x0E PP, +0x14 priority (low 4 bits, two's complement; bit 5 = hits twice), +0x15 (1 = hits 2-5 times, bit 2 = high critical
+hit ratio), +0x2C a pointer to the move's additional effects ({u16 effect, u8 self, u8 chance}, ended by a zero entry), null
+when it has none.
+
+The effect NAMES (the games' own, "BURN_HIT", "SLEEP"...: what moveEffectWords knows) come from the vanilla table
+(MoveStatsGen.kt): for the moves both games share (ids 1-354) each (effect, first additional effect) pair is given the name the
+vanilla move of that pair has most often; a pair seen only on new moves gets none. The side effect chance is the additional
+effect's. Checked against known moves (Flamethrower burn 10%, Thunder paralysis 30%, Bite flinch 30%, Psychic Sp. Def 10%,
+Ice Beam freeze 10%, Spore sleep) and against MoveDataSoulGold.kt's types and powers.
+
+usage: gen_soulgold_move_stats.py pokemon-soulgold-v1.2.1.gba
+"""
+import collections, hashlib, re, struct, sys, pathlib
+
+BASE, STRIDE, COUNT = 0x0877FA48, 0x48, 936
+SHA1 = "32988f918ca09923466ae3bc5bbfe5f2a771c728"
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+DATA = ROOT / "app/src/main/kotlin/com/pokedaisy/app/companion/data"
+
+rom = open(sys.argv[1], "rb").read()
+assert hashlib.sha1(rom).hexdigest() == SHA1, "not SoulGold v1.2.1"
+u8 = lambda a: rom[a - 0x08000000]
+u16 = lambda a: struct.unpack_from("<H", rom, a - 0x08000000)[0]
+u32 = lambda a: struct.unpack_from("<I", rom, a - 0x08000000)[0]
+
+vanilla = [m.group(1) for m in re.finditer(r'^\s+MoveStats\("([A-Z0-9_]*)", \d+, \d+, \d+, -?\d+\),',
+                                           (DATA / "MoveStatsGen.kt").read_text(), re.M)]
+
+def additional(e):
+    p = u32(e + 0x2C)
+    if not 0x08000000 <= p < 0x0A000000:
+        return []
+    out = []
+    for k in range(4):
+        eff, selfb, chance = u16(p + 4 * k), u8(p + 4 * k + 2), u8(p + 4 * k + 3)
+        if eff == 0 and chance == 0:
+            break
+        out.append((eff, selfb, chance))
+    return out
+
+rows = []
+for i in range(COUNT):
+    e = BASE + i * STRIDE
+    bits = u16(e + 0x0A)
+    pr = u8(e + 0x14) & 0xF
+    rows.append(dict(effect=u16(e + 8), type=bits & 0x1F, cat=(bits >> 5) & 3, power=bits >> 7, acc=u8(e + 0x0C) & 0x7F,
+                     pp=u8(e + 0x0E), prio=pr - 16 if pr >= 8 else pr, double=bool(u8(e + 0x14) & 0x20), b15=u8(e + 0x15),
+                     add=[a for a in additional(e) if a[1] == 0]))
+
+# known moves
+chk = {33: (100, 35, 0, 0), 98: (100, 30, 1, 0), 87: (70, 10, 0, 1), 129: (0, 20, 0, 1), 182: (0, 10, 4, 2), 57: (100, 15, 0, 1),
+       68: (100, 20, -5, 0), 233: (0, 10, -1, 0), 264: (100, 20, -3, 0), 24: (100, 30, 0, 0), 46: (0, 20, -6, 2)}
+for i, (acc, pp, prio, cat) in chk.items():
+    r = rows[i]
+    assert (r["acc"], r["pp"], r["prio"], r["cat"]) == (acc, pp, prio, cat), (i, r)
+assert max(r["acc"] for r in rows) <= 100 and all(r["cat"] < 3 for r in rows)
+
+# (effect, first additional effect) -> the vanilla name the shared moves give it most often
+key = lambda r: (r["effect"], r["add"][0][0] if r["add"] else 0)
+votes = collections.defaultdict(collections.Counter)
+for i in range(1, min(355, len(vanilla))):
+    r = rows[i]
+    if r["effect"] == 1 and not r["add"]:
+        continue  # plain hits get their name from the fields below
+    votes[key(r)][vanilla[i]] += 1
+names = {k: c.most_common(1)[0][0] for k, c in votes.items()}
+
+def name_of(r):
+    if r["effect"] == 1:
+        if r["add"]:
+            return names.get(key(r), "")
+        if r["double"]:
+            return "DOUBLE_HIT"
+        if r["b15"] == 1:
+            return "MULTI_HIT"
+        if r["b15"] & 4:
+            return "HIGH_CRITICAL"
+        if r["prio"] > 0:
+            return "QUICK_ATTACK"
+        if r["acc"] == 0 and r["power"] > 0:
+            return "ALWAYS_HIT"
+        return "HIT"
+    return names.get(key(r), "")
+
+for r in rows:
+    r["name"] = name_of(r)
+    r["chance"] = r["add"][0][2] if r["add"] and r["add"][0][2] < 100 else 0
+
+spot = {53: ("BURN_HIT", 10), 87: ("PARALYZE_HIT", 30), 44: ("FLINCH_HIT", 30), 94: ("SPECIAL_DEFENSE_DOWN_HIT", 10),
+        58: ("FREEZE_HIT", 10), 147: ("SLEEP", 0), 33: ("HIT", 0), 98: ("QUICK_ATTACK", 0), 3: ("MULTI_HIT", 0), 2: ("HIGH_CRITICAL", 0),
+        24: ("DOUBLE_HIT", 0), 129: ("ALWAYS_HIT", 0), 330: ("ACCURACY_DOWN_HIT", 30)}
+for i, (nm, ch) in spot.items():
+    assert (rows[i]["name"], rows[i]["chance"]) == (nm, ch), (i, rows[i]["name"], rows[i]["chance"])
+
+known = {int(m.group(1)): (int(m.group(2)), int(m.group(3)))
+         for m in re.finditer(r'^\s+(\d+) to MoveInfo\(".*", (\d+), (\d+)\)', (DATA / "MoveDataSoulGold.kt").read_text(), re.M)}
+bad = [i for i, (t, p) in known.items() if i < COUNT and (rows[i]["type"], rows[i]["power"]) != (t, p)]
+print(f"{len(known)} moves in MoveDataSoulGold.kt, {len(bad)} differ in type / power from this ROM", bad[:10])
+print("moves with a name:", sum(1 for r in rows[1:] if r["name"]), "of", COUNT - 1)
+
+out = ["package com.pokedaisy.app.companion.data\n",
+       f"// GENERATED by scripts/gen_soulgold_move_stats.py from the Pokemon SoulGold v1.2.1 ROM (sha1 {SHA1[:8]}...) - do not hand-edit.",
+       "// gMovesInfo: accuracy (0 = never misses), PP, side effect chance, priority and the effect's name (the games' own, as the",
+       "// vanilla table spells them) of each move; the category of each move is in moveKindsSoulGold.\n",
+       "internal val moveStatsSoulGold: List<MoveStats> = listOf("]
+for r in rows:
+    out.append(f'    MoveStats("{r["name"]}", {r["acc"]}, {r["pp"]}, {r["chance"]}, {r["prio"]}),')
+out.append(")\n")
+out.append("/** One digit per move id: 0 physical, 1 special, 2 status. */")
+out.append(f'internal const val moveKindsSoulGold: String = "{"".join(str(r["cat"]) for r in rows)}"')
+(DATA / "MoveStatsSoulGold.kt").write_text("\n".join(out) + "\n")
+print("wrote MoveStatsSoulGold.kt,", COUNT, "moves")
