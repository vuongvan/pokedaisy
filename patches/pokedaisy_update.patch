+saveBlock2Ptr = 0x03004550
+objectEvents = 0x02038020
+mapHeader = 0x02037F68
+bagPockets = 0x0203AD44
+bagPocketCount = 5
+bagPocketOrder = 'EMERALD_BAG_POCKET_ORDER'
+packedBag = 'PACKED_BAG_EPSILON_EMERALD'
+encryptionKeyOff = 0xAC
+moneyOff = 0x490
+monIconTable = 0x08FE0CD0
+monIconPaletteIndices = 0x08FE15A4
+monIconPaletteTable = 0x08FE17EC
