@@ -73,3 +73,63 @@ partyMenu = 0x0203DE3C
 pokedex = 'POKEDEX_EPSILON_EMERALD'
 guideTables = 'GUIDE_TABLES_EPSILON_EMERALD'
 fieldItems = 'FIELD_ITEMS_EPSILON_EMERALD'
+
+# Pokémon Epsilon Emerald v1.0.3 (same hack, a rebuilt ROM: BPEE, 32 MB, sha1 fec5d319…, crc32 161cbd0d, header title
+# "EPSILON EMER"): the ROM's code and data moved between 1.0.0 and 1.0.3 (not by one shift: gItems and the icon tables
+# +0x86C, gMonPaletteTable and the type chart +0x680, gScriptCmdTable +0x750, the field-control functions +0x48, the var /
+# flag functions +0x60), the RAM did not. A first, partial port, only what a headless boot of a v1.0.3 save checked:
+# - RAM, read live (mGBA headless, a v1.0.3 save standing at a Pokémon Center PC): gSaveBlock1Ptr / 2Ptr 0x0300454C /
+# 0x03004550 (-> 0x020266F4 / 0x02025748), gPlayerParty 0x020251A0 (a Lv9 mon decoded, count byte 1 at 0x0202519D, the
+# enemy party's twelve-mon DMA clear ends at 0x020255EC so gEnemyParty is 0x020253F8), gMain 0x03002BE0 (callbacks are ROM
+# pointers), gMapHeader 0x02037F68 (a valid header), gObjectEvents 0x02038020 (the player at +7 of SaveBlock1's pos), and
+# gBagPockets 0x0203AD44 in 1.0.0's layout (Items 72 at SaveBlock1 + 0x560, Poké Balls 16 + 0x650, TMs & HMs 118 +0x3598,
+# Berries 46 + 0x790, Key Items 60 at 0x02032988). Money (+0x490 xor the key at SaveBlock2 + 0xAC) decodes to 9,957,379,
+# which wants a look at the game's own screen.
+# - ROM: gItems 0x08FEECA4 (found from "Master Ball" and a 36-byte stride; the GF header's gItems is the same), the icon
+# tables from the GF header (0x08000138, 0x08000140) and the literal pool words that name them, gMonPaletteTable 0x08BE5D40
+# (header 0x08000130).
+# The battle menu handlers are 1.0.0's +0x10: each found by its prologue and a literal pool naming the same gMain, cursor,
+# gBattleStruct, gBattleTypeFlags and gBattlerControllerFuncs RAM as in 1.0.0 (so that RAM is 1.0.0's too).
+# The Pokédex tables (POKEDEX_EPSILON_EMERALD_V1_0_3, Pokedex.kt) were each found by their content.
+# NOT in this config (the addresses weren't found yet, so nothing reads them): the HERE tables, PC anywhere and FLY, and WIDE.
+[config.epsilon_emerald_v1_0_3]
+itemDescs = { base = 0x08FEECA4, stride = 36, descOff = 0x14, count = 629 }
+playerParty = 0x020251A0
+playerPartyCount = 0x0202519D
+battleMons = 0x02024C50
