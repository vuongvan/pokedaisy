+     * no source). gSpecials' first entry is HealPlayerParty in every build, and [fns]' own addresses name what it must do: call
+     * GetMonData and SetMonData ([PartyItemFns]) and hold gPlayerPartyCount in its literals. A build that matches all three
+     * gets the nurse's special at index 0 and Emerald's jingle (a wrong song id only silences it); one that doesn't gets null.
+     * The Name Rater, the Move Deleter and the Move Tutor are left out (nothing here knows their specials). Played headless on
+     * SoulGold v1.2.1: the script ran ScriptContext_SetupScript on the field, both damaged party Pokémon came back to full HP.
+     */
+    fun healOnly(rom: LittleEndianReader, fns: FieldItemFns): Found? {
+        val pc = fns.pc ?: return null
+        val party = fns.party ?: return null
+        val table = (pc.specials - 0x08000000L).toInt()
+        if (table < 0 || table + 4 > rom.limit()) return null
+        val entry = word(rom, table)
+        if (!isThumbRom(entry)) return null
+        val f = fn(entry)
+        if (f + 0x240 > rom.limit()) return null
+        var getMon = false
+        var setMon = false
+        var countLiteral = false
+        var o = 0
+        while (o < 0x200) {
+            val h1 = rom.getShort(f + o).toInt() and 0xFFFF
+            val h2 = rom.getShort(f + o + 2).toInt() and 0xFFFF
+            if (h1 and 0xF800 == 0xF000 && h2 and 0xF800 == 0xF800) {
+                var off = ((h1 and 0x7FF) shl 12) or ((h2 and 0x7FF) shl 1)
+                if (off and (1 shl 22) != 0) off -= 1 shl 23
+                val target = 0x08000000L + f + o + 4 + off
+                if (target == party.getMonData) getMon = true
+                if (target == party.setMonData) setMon = true
+            }
+            if (o and 3 == 0 && word(rom, f + o) == party.partyCount) countLiteral = true
+            o += 2
+        }
+        if (!getMon || !setMon || !countLiteral) return null
+        return Found(pc.specials, 0, null, null, null, null, null, 0L, 0L, 368, 378)
+    }
